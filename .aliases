alias cc='claude'

alias g='git'
alias ga='git add'
alias gaa='git add -A'
alias gau='git add -u'
alias gb='git branch'
alias gbd='git branch -D'
alias gch='git checkout'
alias gchb='git checkout -b'
alias gchm='git checkout main'
alias gcl='git clone'
alias gcm='git commit -m'
alias gcma='git commit --amend --no-edit'
alias gd='git diff'
alias gf='git fetch'
alias gl='git log'
alias gln='git log --name-status'
alias gm='git merge'
alias gmm='git merge main'
alias gp='git push'
alias gpf='git push -f'
alias gpl='git pull'
alias gps='git push --set-upstream origin HEAD'
alias gr='git reset'
alias gs='git status'

alias la='ls -a'
alias ll='ls -al'

brewup() (
	run() {
		printf '\n==> %s\n' "$*"
		"$@"
	}

	run brew update &&
		run brew bundle install &&
		run brew bundle cleanup --force &&
		run brew cleanup --prune=all
)

cc-instruct() (
	cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || {
		echo "Not in a git repo; run git init first" >&2
		return 1
	}
	if [[ -e .claude/settings.local.json ]]; then
		echo ".claude/settings.local.json already exists; merge by hand" >&2
		return 1
	fi
	local exclude=$(git rev-parse --git-path info/exclude)
	mkdir -p .claude "$(dirname "$exclude")"
	cat >.claude/settings.local.json <<'EOF'
{
  "outputStyle": "Instructor",
  "permissions": {
    "deny": ["Edit(./**)", "Write(./**)", "NotebookEdit"]
  }
}
EOF
	for f in .claude/ CLAUDE.md AGENTS.md PLAN.md; do
		grep -qxF "$f" "$exclude" 2>/dev/null || echo "$f" >>"$exclude"
	done
	echo "Instructor mode set up. Start a new Claude session to use it."
)

chpwd() {
	ls -a
}

dsrm() {
	find . -type d \( -name "Library" -o -name ".Trash" \) -prune \
		-o -type f -name ".DS_Store" -exec rm {} +
}

gbda() {
	git branch -D $(git branch | grep "$@")
}

gpusa() {
	for dir in ./*; do
		if [ -d "$dir/.git" ]; then
			cd "$dir"
			git push
			cd ..
		fi
	done
}

grh() {
	git reset --hard HEAD~"$@"
}

grs() {
	git reset --soft HEAD~"$@"
}

mkcd() {
	mkdir -p -- "$1" && cd -- "$1"
}

rmhist() {
	echo "Clearing history..."
	rm -rf ~/.zsh_history
	fc -p
	echo "History cleared."
}

ww() {
	local end_hour=$(("${1:-5}" + 12))
	echo "Running until $end_hour:00!"

	while true; do
		current_hour=$(date +%H)
		if [ "$current_hour" -lt "$end_hour" ]; then
			cliclick m:+1,+1 m:-1,-1
		fi
		sleep 59
	done &
}
