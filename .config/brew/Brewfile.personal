cask "claude"
cask "claude-code"
cask "firefox"
cask "google-chrome"
cask "google-drive"
cask "livebook"
cask "maccy"
cask "protonvpn"
cask "rectangle"
cask "signal"
cask "visual-studio-code"
cask "workflowy"
